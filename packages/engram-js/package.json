{
  "name": "engram-js",
  "version": "1.4.0",
  "author": "caviraoss",
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "opm": "./bin/opm.js",
    "engram": "./bin/opm.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "migrate": "tsx src/database/migrate.ts",
    "migration-report": "tsx src/database/legacyMigrationReport.ts",
    "release-smoke": "npm run build && node dist/releaseSmoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.932.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "langfuse": "^3.38.20",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^4.7.1",
    "sqlite3": "^6.0.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/pg": "^8.15.6",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
