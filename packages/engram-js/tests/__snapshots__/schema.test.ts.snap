      note text,
      active boolean not null default true,
      created_at timestamptz not null default now()
    )",
  "create index if not exists durable_judge_calibration_trace_idx on "engram"."judge_calibration" (trace_id)",
  "create table if not exists "engram"."integrity_runs" (
      id uuid primary key,
      started_at timestamptz not null default now(),
      completed_at timestamptz,
      tier2_enabled boolean not null default false,
      summary jsonb not null default '{}'::jsonb,
      gate jsonb not null default '{}'::jsonb
    )",
  "create table if not exists "engram"."integrity_findings" (
      id uuid primary key default gen_random_uuid(),
      run_id uuid not null references "engram"."integrity_runs"(id) on delete cascade,
      check_name text not null,
      memory_id uuid references "engram"."memories"(id) on delete set null,
      severity text not null default 'medium',
      action_taken text not null default 'none',
      detail jsonb not null default '{}'::jsonb,
      status text not null default 'open',
      created_at timestamptz not null default now(),
      resolved_at timestamptz
    )",
  "create index if not exists durable_integrity_findings_status_idx on "engram"."integrity_findings" (status, severity)",
  "create index if not exists durable_integrity_findings_run_idx on "engram"."integrity_findings" (run_id)",
  "create table if not exists "engram"."judge_evals" (
