# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — values that CANNOT be set via the web GUI.
#
# Everything else (models, provider, server tuning, rate limits, compaction,
# auto-search, consolidation tiers, API key, advanced infra/secrets) is managed
# in the web GUI Settings tab, persisted in Postgres, and applied at boot.
# Do NOT add model/server/tuning variables here — they belong in the Settings tab.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM box — read at startup; edited effectively via the GUI (Provider Settings,
#    which wins at runtime). Values here bootstrap the provider on first boot. ──
EG_GENERATIVE_URL=http://10.10.10.41:8080/v1
EG_UPSTREAM_LLM_URL=http://10.10.10.41:8080/v1
EG_OPENAI_BASE_URL=http://10.10.10.41:8080/v1
EG_OPENAI_API_KEY=sk-engram

# ── Database / Redis — read at startup, BEFORE the settings store is available ─
EG_PG_HOST=postgres
EG_PG_PORT=5432
EG_PG_DB=engram
EG_PG_USER=postgres
EG_PG_PASSWORD=change-me
EG_PG_SCHEMA=
EG_PG_SSL=

EG_REDIS_URL=redis://redis:6379

# ── Logging — read at startup by the logger module (before settings load) ─────────────
EG_LOG_DIR=/home/ftr/Apps/Engram/logs
EG_LOG_MAX_LINES=3000

# ── Living Model (v5.0.0) — self-improving learning loop ───────────────────────────────
# The learning loop reads judge score trends, proposes hyperparameter adjustments,
# and optionally auto-applies small deltas. Flag-first by default.
# EG_LEARNING_ENABLED=true
# EG_LEARNING_AUTO_APPLY=false
# EG_LEARNING_MAX_DELTA=0.1

# Outcome-aware memory: salience driven by measured usefulness (does recalling
# a memory actually help answers?). Sits on top of the existing decay engine.
# EG_OUTCOME_TRACKING_ENABLED=true
# EG_OUTCOME_DECAY_PENALTY=2.0
# EG_OUTCOME_DECAY_BOOST=0.5
# EG_OUTCOME_RECALL_PENALTY=0.5
# EG_OUTCOME_RECALL_BOOST=1.2

# Curriculum engine: weekly self-directed gap probing (default OFF).
# EG_CURRICULUM_ENABLED=false

# ── Internal / runtime ────────────────────────────────────────────────────────
EG_INTERNAL_API_KEY=
LOG_LEVEL=info
NODE_ENV=
